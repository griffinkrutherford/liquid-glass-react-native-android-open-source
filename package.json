{
  "name": "@griffinkrutherford/liquid-glass-android",
  "version": "0.1.0",
  "description": "Physical liquid glass views for React Native on Android",
  "source": "src/index.tsx",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "files": [
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/gradle.properties",
    "android/settings.gradle",
    "android/src",
    "liquid-glass-core/src/main",
    "liquid-glass-view/src/main",
    "src",
    "!src/__tests__",
    "docs",
    "lib",
    "react-native.config.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "android:bridge-check": "bob build --target codegen && ./gradlew -I gradle/react-native-validation.gradle :liquid-glass-view:compileDebugKotlin",
    "clean": "bob clean",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:pack": "bash scripts/pack-and-install.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "example:install": "node scripts/example-install.mjs",
    "example:typecheck": "npm --prefix example-react-native run typecheck",
    "example:bundle": "npm --prefix example-react-native run bundle:check",
    "example:start": "npm --prefix example-react-native run start",
    "example:android": "npm --prefix example-react-native run android",
    "example:android:release": "npm --prefix example-react-native run android:release",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "android",
    "liquid-glass",
    "refraction",
    "fabric"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/griffinkrutherford/liquid-glass-react-native-android-open-source.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@react-native/babel-preset": "^0.81.6",
    "@react-native/codegen": "^0.81.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "^19.1.0",
    "react-native": "^0.81.0",
    "react-native-builder-bob": "^0.40.13",
    "react-test-renderer": "^19.2.8",
    "typescript": "^5.8.3"
  },
  "codegenConfig": {
    "name": "RNLiquidGlassSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.github.griffinkrutherford.liquidglass.react"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ],
      "codegen"
    ]
  }
}
